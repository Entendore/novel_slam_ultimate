<?xml version="1.0"?>
<robot name="slam_robot">
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="0.3" length="0.3"/>
      </geometry>
    </visual>
  </link>
  
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
    </visual>
  </link>
  
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.25"/>
  </joint>
</robot>
